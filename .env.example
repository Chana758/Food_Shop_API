# Copy to .env.local. Leave the API values empty to use the hosted backend on Render.

# Laravel API (with /api) and the backend base URL (used for images and payments)
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000

# Laravel Reverb (real-time order updates). The key must match REVERB_APP_KEY on the backend.
VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
